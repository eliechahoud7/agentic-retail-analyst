# Copy to .env and fill in PGPASSWORD. Never commit .env.
# The agents connect with the dedicated read-only account created by sql/02_create_agent_role.sql.
PGHOST=localhost
PGPORT=5432
PGDATABASE=retail_intelligence
PGUSER=retail_agent_ro
PGPASSWORD=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Optional per-agent overrides (empty = use OLLAMA_MODEL).
# Using one model for all agents avoids model swapping on a 2 GB GPU.
SUPERVISOR_MODEL=
DATA_ANALYST_MODEL=
ANALYTICS_MODEL=
